# DroneCores catalogue Phase 2
# Server-only values. Never prefix these with VITE_ and never commit real values.

# Supabase project API URL, for example:
# https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Use a modern Supabase server secret key (sb_secret_...).
# Never expose this value to browser code, screenshots, chat, or source control.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Safety switch. The live configurator remains on the static catalogue unless this
# is explicitly set to true AND database parity is verified by server-side code.
CATALOGUE_DATABASE_ENABLED=false
