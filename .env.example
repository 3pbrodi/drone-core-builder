# DroneCores catalogue Phase 2
# Server-only values. Never prefix these with VITE_ and never commit real values.

# Supabase project API URL, for example:
# https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Use a modern Supabase server secret key (sb_secret_...).
# Never expose this value to browser code, screenshots, chat, or source control.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Runtime catalogue switch. After the verified-catalogue cutover, keep this true.
# Set it to false only as an emergency kill switch. If omitted, DroneCores enables
# the database catalogue automatically when both server-only Supabase values exist.
CATALOGUE_DATABASE_ENABLED=true
